<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:VademecumDigitalis.Converters"
             x:Class="VademecumDigitalis.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- AVENTURISCHES MANUSKRIPT – Dark Theme                              -->
            <!-- Farbtokens, Typografie und Komponentenstile.                       -->
            <!-- Einheitlich, deshalb hier zentral.                                 -->
            <!-- ════════════════════════════════════════════════════════════════ -->

            <!-- ─── Flächen (warme Eiche) ─────────────────────────────────────── -->
            <Color x:Key="Background">#1C1510</Color>
            <Color x:Key="SurfaceLow">#261C14</Color>
            <Color x:Key="SurfaceHigh">#322519</Color>
            <Color x:Key="SurfaceElevated">#3F2E1F</Color>
            <Color x:Key="Border">#5C4423</Color>
            <Color x:Key="BorderSoft">#3A2A1B</Color>

            <!-- ─── Akzent (Gold/Bernstein) ───────────────────────────────────── -->
            <Color x:Key="GoldBright">#E8C580</Color>
            <Color x:Key="Gold">#C8A96E</Color>
            <Color x:Key="GoldDeep">#8A6F3D</Color>
            <Color x:Key="Amber">#E8B36A</Color>

            <!-- ─── Semantik ──────────────────────────────────────────────────── -->
            <Color x:Key="Success">#6E8B5C</Color>
            <Color x:Key="Danger">#B83D38</Color>
            <Color x:Key="Warning">#E0A953</Color>
            <Color x:Key="Info">#7193B0</Color>
            <Color x:Key="Magic">#8E5BAE</Color>
            <Color x:Key="Karmal">#D4A85C</Color>

            <!-- ─── Text ──────────────────────────────────────────────────────── -->
            <Color x:Key="TextPrimary">#ECDFC4</Color>
            <Color x:Key="TextSecondary">#B8A88C</Color>
            <Color x:Key="TextMuted">#7A6D58</Color>
            <Color x:Key="TextDisabled">#4F4538</Color>
            <Color x:Key="TextOnGold">#1C1510</Color>

            <!-- ─── Hauptattribute (DSA 5) ────────────────────────────────────── -->
            <Color x:Key="AttrMU">#D85959</Color>
            <Color x:Key="AttrKL">#6BB5FF</Color>
            <Color x:Key="AttrIN">#C19BFF</Color>
            <Color x:Key="AttrCH">#FF8FB1</Color>
            <Color x:Key="AttrFF">#E8C580</Color>
            <Color x:Key="AttrGE">#6BCF7F</Color>
            <Color x:Key="AttrKO">#E89D52</Color>
            <Color x:Key="AttrKK">#D4A574</Color>

            <!-- ─── Legacy-Aliase (Bestandsbindings rauskompatibel) ───────────── -->
            <!-- Diese Namen werden noch in vielen XAMLs referenziert.
                 Sie verweisen jetzt auf die neuen Tokens. -->
            <Color x:Key="Primary">#C8A96E</Color>
            <Color x:Key="BackgroundDark">#1C1510</Color>
            <Color x:Key="SurfaceDark">#261C14</Color>
            <Color x:Key="CardBackground">#261C14</Color>
            <Color x:Key="InputBackground">#322519</Color>
            <Color x:Key="BorderColor">#5C4423</Color>
            <Color x:Key="AccentCyan">#C8A96E</Color>

            <!-- ─── Converters ────────────────────────────────────────────────── -->
            <converters:IntStringConverter x:Key="IntStringConverter" />
            <converters:AttributeColorConverter x:Key="AttributeColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:StatusButtonColorConverter x:Key="StatusButtonColorConverter" />

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- DEFAULT-STYLES (greifen ohne x:Key auf alle Elemente)              -->
            <!-- ════════════════════════════════════════════════════════════════ -->

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
            </Style>

            <Style TargetType="Editor">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Color" Value="{StaticResource Gold}" />
            </Style>

            <Style TargetType="SearchBar">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
                <Setter Property="CancelButtonColor" Value="{StaticResource Gold}" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="TitleColor" Value="{StaticResource TextMuted}" />
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
            </Style>

            <Style TargetType="TimePicker">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
            </Style>

            <Style TargetType="Switch">
                <Setter Property="OnColor" Value="{StaticResource Gold}" />
                <Setter Property="ThumbColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BackgroundColor" Value="{StaticResource Gold}" />
                <Setter Property="TextColor" Value="{StaticResource TextOnGold}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <Style TargetType="ActivityIndicator">
                <Setter Property="Color" Value="{StaticResource Gold}" />
            </Style>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- TYPOGRAFIE-STYLES (mit x:Key)                                      -->
            <!-- ════════════════════════════════════════════════════════════════ -->

            <Style x:Key="DisplayLargeLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Cinzel" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GoldBright}" />
                <Setter Property="CharacterSpacing" Value="2" />
            </Style>

            <Style x:Key="DisplaySmallLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Cinzel" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GoldBright}" />
                <Setter Property="CharacterSpacing" Value="2" />
            </Style>

            <!-- Page-Title (HeadlineLabel-Alias: vorhandene Bindings funktionieren weiter) -->
            <Style x:Key="HeadlineLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Cinzel" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Gold}" />
                <Setter Property="CharacterSpacing" Value="2" />
                <Setter Property="Margin" Value="0,8,0,8" />
            </Style>

            <Style x:Key="SubheadLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Cinzel" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Gold}" />
                <Setter Property="CharacterSpacing" Value="1" />
                <Setter Property="Margin" Value="0,6,0,4" />
            </Style>

            <Style x:Key="SectionHeaderLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Cinzel" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Gold}" />
                <Setter Property="CharacterSpacing" Value="1" />
            </Style>

            <Style x:Key="ProseLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Cormorant" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="ProseItalicLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="CormorantItalic" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>

            <Style x:Key="BodyLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="BodySmallLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>

            <Style x:Key="MutedLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="CharacterSpacing" Value="2" />
            </Style>

            <Style x:Key="TableHeaderLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextOnGold}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="CharacterSpacing" Value="1" />
            </Style>

            <Style x:Key="NumericLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GoldBright}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="NumericLargeLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource GoldBright}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="MonoLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Mono" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- KOMPONENTEN-STYLES                                                 -->
            <!-- ════════════════════════════════════════════════════════════════ -->

            <!-- Karte (Standard) -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLow}" />
                <Setter Property="Stroke" Value="{StaticResource Border}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,4" />
            </Style>

            <!-- Karte hervorgehoben -->
            <Style x:Key="ElevatedCardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="Stroke" Value="{StaticResource Gold}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,4" />
            </Style>

            <!-- Karte „Goldenes Wappen" – für Hauptinfos -->
            <Style x:Key="SigilCardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLow}" />
                <Setter Property="Stroke" Value="{StaticResource Gold}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,6" />
            </Style>

            <!-- Sektion-Trenner (Linie + Ornament-Glyph optional außen rum) -->
            <Style x:Key="Divider" TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="BackgroundColor" Value="{StaticResource BorderSoft}" />
                <Setter Property="Margin" Value="0,8" />
            </Style>

            <!-- Buttons -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BackgroundColor" Value="{StaticResource Gold}" />
                <Setter Property="TextColor" Value="{StaticResource TextOnGold}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="TextColor" Value="{StaticResource Gold}" />
                <Setter Property="BorderColor" Value="{StaticResource Gold}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                <Setter Property="TextColor" Value="#FFFFFF" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Gold}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="MinimumHeightRequest" Value="36" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Gold}" />
                <Setter Property="WidthRequest" Value="36" />
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <!-- Numeric-Eingabefeld (helle Inputs wie bisher, aber thematisch eingebunden) -->
            <Style x:Key="NumericEntry" TargetType="Entry">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Keyboard" Value="Numeric" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <!-- Badge-Stile -->
            <Style x:Key="BadgeBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 4" />
                <Setter Property="Padding" Value="6,3" />
            </Style>

            <Style x:Key="BadgeLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="CharacterSpacing" Value="1" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
