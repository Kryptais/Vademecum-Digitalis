<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VademecumDigitalis.TalentsPageModern"
             Title="Talente (Modern)">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12"
                             BindableLayout.ItemsSource="{Binding TalentGruppen}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="8">
                        <!-- Collapsible Header -->
                        <Grid ColumnDefinitions="Auto,*" Padding="12,10" BackgroundColor="#0E7490" 
                              RowSpacing="0" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleExpandCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Label Grid.Column="0" 
                                   Text="{Binding IsExpanded, StringFormat='{0:?▼:▶}'}" 
                                   FontSize="14" TextColor="White" FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Gruppe}" TextColor="White" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                        </Grid>

                        <!-- Content - shown when IsExpanded is true -->
                        <VerticalStackLayout Spacing="0" IsVisible="{Binding IsExpanded}">
                            <!-- Header Row -->
                            <Grid ColumnDefinitions="2.2*,1*,0.9*,0.9*,0.9*,1.1*,0.8*,1.6*"
                                  ColumnSpacing="6"
                                  Padding="12,12"
                                  BackgroundColor="#0E7490">
                                <Label Grid.Column="0" Text="Talent" FontAttributes="Bold" FontSize="13" TextColor="White" />
                                <Label Grid.Column="1" Text="Steigerungsfaktor" FontAttributes="Bold" FontSize="13" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Column="2" Text="Probe 1" FontAttributes="Bold" FontSize="13" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Column="3" Text="Probe 2" FontAttributes="Bold" FontSize="13" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Column="4" Text="Probe 3" FontAttributes="Bold" FontSize="13" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Column="5" Text="Belastungseinfluss" FontAttributes="Bold" FontSize="13" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Column="6" Text="FW" FontAttributes="Bold" FontSize="13" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Column="7" Text="Anmerkung" FontAttributes="Bold" FontSize="13" TextColor="White" HorizontalOptions="Center" />
                            </Grid>

                            <!-- Data Rows with Zebra Striping -->
                            <VerticalStackLayout Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding Eintraege}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="2.2*,1*,0.9*,0.9*,0.9*,1.1*,0.8*,1.6*"
                                              ColumnSpacing="6"
                                              Padding="12,14"
                                              BackgroundColor="DarkGray">
                                            <Label Grid.Column="0" Text="{Binding Talent}" FontSize="12" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Steigerungsfaktor}" FontAttributes="Bold" HorizontalOptions="Center" FontSize="12" VerticalOptions="Center" TextColor="#0E7490" />
                                            <Label Grid.Column="2" Text="{Binding Probe1}" HorizontalOptions="Center" FontSize="11" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="{Binding Probe2}" HorizontalOptions="Center" FontSize="11" VerticalOptions="Center" />
                                            <Label Grid.Column="4" Text="{Binding Probe3}" HorizontalOptions="Center" FontSize="11" VerticalOptions="Center" />
                                            <Label Grid.Column="5" Text="{Binding Belastungseinfluss}" HorizontalOptions="Center" FontSize="11" VerticalOptions="Center" />
                                            <Entry Grid.Column="6" Keyboard="Numeric" Text="{Binding Fw}" FontSize="11" HorizontalTextAlignment="Center" />
                                            <Entry Grid.Column="7" Text="{Binding Anmerkung}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>