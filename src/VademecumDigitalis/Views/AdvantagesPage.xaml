<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:VademecumDigitalis.Models"
             xmlns:viewmodels="clr-namespace:VademecumDigitalis.ViewModels"
             x:Class="VademecumDigitalis.AdvantagesPage"
             x:DataType="viewmodels:VorteilNachteilViewModel"
             Title="Vorteile/Nachteile">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="Vorteile &amp; Nachteile" Style="{StaticResource HeadlineLabel}" Margin="0,0,0,0" />
                    <Label Text="AP-Bilanz und regeltechnische Effekte."
                           TextColor="{StaticResource TextSecondary}" FontSize="12" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="＋"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        FontSize="20"
                        BackgroundColor="{StaticResource AccentCyan}"
                        Clicked="OnToggleSearchClicked" />
            </Grid>

            <!-- Stats-Leiste -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding VorteileCount}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Gold}" />
                        <Label Text="Vorteile" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding NachteileCount}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                        <Label Text="Nachteile" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding GesamtApAnzeige}" FontSize="14" FontAttributes="Bold" />
                        <Label Text="Bilanz" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Suchbereich -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsSearchVisible}">
                <VerticalStackLayout Spacing="12">
                    <Border Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource InputBackground}"
                            Padding="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding KatalogModusTitel}"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Label Text="Katalogauswahl"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="Nachteile"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding ShowNachteile}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <SearchBar Placeholder="Name, Kategorie oder Regeltext suchen"
                               Text="{Binding SearchText}" />

                    <CollectionView ItemsSource="{Binding SearchResults}"
                                    MaximumHeightRequest="420"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Keine passenden Einträge gefunden."
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,16" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:VorteilNachteil">
                                <Border Stroke="{StaticResource BorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource InputBackground}"
                                        Padding="12"
                                        Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" />
                                            <Label Text="{Binding ApKostenAnzeige}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                                                Text="＋"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0"
                                                BackgroundColor="{StaticResource AccentCyan}"
                                                Clicked="OnAddFromCatalogClicked"
                                                CommandParameter="{Binding .}" />
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding Beschreibung}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="8">
                                            <Label Text="{Binding KategorieAnzeige}" FontSize="11" TextColor="{StaticResource AccentCyan}" />
                                            <Label Text="{Binding EffektKurztext}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                            <Label Text="{Binding Anmerkungen}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Leer-Hinweis -->
            <Label Text="Noch keine Vorteile oder Nachteile eingetragen."
                   IsVisible="{Binding KeineVorteileNachteile}"
                   TextColor="{StaticResource TextSecondary}"
                   FontSize="14"
                   HorizontalOptions="Center"
                   Margin="0,18" />

            <!-- Nebeneinander: Vorteile (links) | Nachteile (rechts) -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10"
                  IsVisible="{Binding HatVorteileNachteile}">

                <!-- === VORTEILE === -->
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource Gold}"
                            StrokeThickness="1.5"
                            BackgroundColor="{StaticResource Gold}"
                            Padding="8,6">
                        <Label Text="✦ Vorteile" FontAttributes="Bold" FontSize="14" TextColor="White" />
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding VorteileEintraege}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CharakterVorteilNachteilEintrag">
                                <Border StrokeShape="RoundRectangle 8"
                                        Stroke="{StaticResource Gold}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource SurfaceLow}"
                                        Padding="10,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="3">
                                        <!-- Name + Stufe -->
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                            <Label Text="{Binding DisplayName}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource GoldBright}" />
                                            <Label Text="{Binding StufeAnzeige}"
                                                   FontSize="12" TextColor="{StaticResource Gold}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <!-- Details Button -->
                                        <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                                Text="ℹ"
                                                WidthRequest="36" HeightRequest="36" Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource GoldBright}"
                                                FontSize="14"
                                                Clicked="OnDetailsClicked"
                                                CommandParameter="{Binding .}" />
                                        <!-- Level-Down Button -->
                                        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                                Text="▼"
                                                WidthRequest="36" HeightRequest="36" Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Gold}"
                                                FontSize="14"
                                                IsVisible="{Binding KannReduzieren}"
                                                Clicked="OnLevelDownClicked"
                                                CommandParameter="{Binding .}" />
                                        <!-- Level-Up Button -->
                                        <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"
                                                Text="▲"
                                                WidthRequest="36" HeightRequest="36" Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Gold}"
                                                FontSize="14"
                                                IsVisible="{Binding KannAufsteigen}"
                                                Clicked="OnLevelUpClicked"
                                                CommandParameter="{Binding .}" />
                                        <!-- Entfernen Button -->
                                        <Button Grid.Row="0" Grid.Column="4" Grid.RowSpan="2"
                                                Text="✕"
                                                WidthRequest="36" HeightRequest="36" Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource TextMuted}"
                                                FontSize="13"
                                                Clicked="OnEntfernenClicked"
                                                CommandParameter="{Binding .}" />
                                        <!-- AP + Kategorie -->
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                                            <Label Text="{Binding ApKostenDisplay}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource Gold}" />
                                            <Label Text="{Binding KategorieAnzeige}"
                                                   FontSize="10"
                                                   TextColor="{StaticResource BorderSoft}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- === NACHTEILE === -->
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource Danger}"
                            StrokeThickness="1.5"
                            BackgroundColor="{StaticResource Danger}"
                            Padding="8,6">
                        <Label Text="✦ Nachteile" FontAttributes="Bold" FontSize="14" TextColor="White" />
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding NachteileEintraege}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CharakterVorteilNachteilEintrag">
                                <Border StrokeShape="RoundRectangle 8"
                                        Stroke="{StaticResource Danger}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource SurfaceLow}"
                                        Padding="10,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="3">
                                        <!-- Name + Stufe -->
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                            <Label Text="{Binding DisplayName}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource Danger}" />
                                            <Label Text="{Binding StufeAnzeige}"
                                                   FontSize="12" TextColor="{StaticResource Danger}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <!-- Details Button -->
                                        <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                                Text="ℹ"
                                                WidthRequest="36" HeightRequest="36" Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Danger}"
                                                FontSize="14"
                                                Clicked="OnDetailsClicked"
                                                CommandParameter="{Binding .}" />
                                        <!-- Level-Down Button -->
                                        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                                Text="▼"
                                                WidthRequest="36" HeightRequest="36" Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Danger}"
                                                FontSize="14"
                                                IsVisible="{Binding KannReduzieren}"
                                                Clicked="OnLevelDownClicked"
                                                CommandParameter="{Binding .}" />
                                        <!-- Level-Up Button -->
                                        <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"
                                                Text="▲"
                                                WidthRequest="36" HeightRequest="36" Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Danger}"
                                                FontSize="14"
                                                IsVisible="{Binding KannAufsteigen}"
                                                Clicked="OnLevelUpClicked"
                                                CommandParameter="{Binding .}" />
                                        <!-- Entfernen Button -->
                                        <Button Grid.Row="0" Grid.Column="4" Grid.RowSpan="2"
                                                Text="✕"
                                                WidthRequest="36" HeightRequest="36" Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource BorderSoft}"
                                                FontSize="13"
                                                Clicked="OnEntfernenClicked"
                                                CommandParameter="{Binding .}" />
                                        <!-- AP + Kategorie -->
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                                            <Label Text="{Binding ApKostenDisplay}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource Danger}" />
                                            <Label Text="{Binding KategorieAnzeige}"
                                                   FontSize="10"
                                                   TextColor="{StaticResource BorderSoft}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
