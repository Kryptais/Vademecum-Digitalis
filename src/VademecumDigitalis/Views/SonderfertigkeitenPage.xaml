<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:VademecumDigitalis.Models"
             x:Class="VademecumDigitalis.SonderfertigkeitenPage"
             Title="Sonderfertigkeiten">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Sonderfertigkeiten" Style="{StaticResource HeadlineLabel}" />
            <Label Text="Profane Sonderfertigkeiten nach Kategorie gruppiert."
                   TextColor="{StaticResource TextSecondary}" FontSize="14" Margin="0,-8,0,4" />

            <!-- Button: Neue Sonderfertigkeit -->
            <Button Text="＋ Neue Sonderfertigkeit" Clicked="OnToggleSearchClicked"
                    BackgroundColor="{StaticResource AccentCyan}" TextColor="White" />

            <!-- Such-/Hinzufügen-Bereich (toggle) -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsSearchVisible}">
                <VerticalStackLayout Spacing="10" Padding="4">

                    <!-- Homebrew-Toggle -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="Homebrew erstellen" VerticalOptions="Center" FontSize="14" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsHomebrewMode}" />
                    </Grid>

                    <!-- Katalogsuche -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsCatalogSearchMode}">
                        <Entry x:Name="SearchEntry" Placeholder="SF-Name suchen…"
                               Text="{Binding SearchText}" />
                        <CollectionView ItemsSource="{Binding SearchResults}"
                                        MaximumHeightRequest="300"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SpecialAbility">
                                    <Border Stroke="{StaticResource TextSecondary}" StrokeThickness="0.5"
                                            StrokeShape="RoundRectangle 6" Padding="10,8" Margin="0,2">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label FontSize="14" FontAttributes="Bold">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Name}" />
                                                            <Span Text=" " />
                                                            <Span Text="{Binding Anmerkungen}" FontSize="11"
                                                   TextColor="{StaticResource TextSecondary}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label Text="{Binding Beschreibung}" FontSize="11"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       MaxLines="2" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="＋" FontSize="16"
                                                    Padding="8,4" WidthRequest="40"
                                                    BackgroundColor="{StaticResource AccentCyan}" TextColor="White"
                                                    Clicked="OnAddFromCatalogClicked"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Homebrew-Formular -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsHomebrewMode}">
                        <Label Text="Eigene Sonderfertigkeit erstellen" Style="{StaticResource SectionHeaderLabel}" />
                        <Entry Placeholder="Name" Text="{Binding HomebrewName}" />
                        <Editor Placeholder="Beschreibung / Regeltext" Text="{Binding HomebrewBeschreibung}"
                                HeightRequest="80" AutoSize="TextChanges" />
                        <Picker Title="Kategorie wählen…"
                                ItemsSource="{Binding KategorieNamen}"
                                SelectedIndex="{Binding HomebrewKategorieIndex}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Max. Stufe" FontSize="12" />
                                <Entry Placeholder="1" Keyboard="Numeric"
                                       Text="{Binding HomebrewMaxStufe}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="AP-Kosten (pro Stufe, kommagetrennt)" FontSize="12" />
                                <Entry Placeholder="z.B. 15,20,25" Keyboard="Numeric"
                                       Text="{Binding HomebrewApKosten}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Entry Placeholder="Anmerkungen (optional)" Text="{Binding HomebrewAnmerkungen}" />
                        <Button Text="Homebrew hinzufügen" Clicked="OnAddHomebrewClicked"
                                BackgroundColor="{StaticResource AccentCyan}" TextColor="White" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Leere-Liste-Hinweis -->
            <Label Text="Noch keine Sonderfertigkeiten eingetragen."
                   IsVisible="{Binding KeineSonderfertigkeiten}"
                   TextColor="{StaticResource TextSecondary}"
                   FontSize="14" HorizontalOptions="Center" Margin="0,8" />

            <!-- Gruppierte Liste -->
            <CollectionView ItemsSource="{Binding GruppierteSonderfertigkeiten}"
                            IsGrouped="True"
                            SelectionMode="None">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="models:SfGruppe">
                        <VerticalStackLayout Padding="0,10,0,4">
                            <Label Text="{Binding Kategorie}" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource AccentCyan}" />
                            <BoxView HeightRequest="1" Color="{StaticResource TextSecondary}" Opacity="0.3" />
                    </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CharakterSonderfertigkeitEintrag">
                        <Border Style="{StaticResource CardBorder}" Margin="0,3">
                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="12,10" ColumnSpacing="6">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Anzeige}" FontSize="15" FontAttributes="Bold" />
                                    <Label Text="{Binding KategorieAnzeige}" FontSize="12"
                                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
                                <!-- Level-up Button (nur bei stufenbasierten SFs) -->
                                <Button Grid.Column="1" Text="▲" FontSize="14"
                                        Padding="8,4" WidthRequest="40"
                                        BackgroundColor="Transparent" TextColor="{StaticResource AccentCyan}"
                                        IsVisible="{Binding KannAufsteigen}"
                                        Clicked="OnLevelUpClicked"
                                        CommandParameter="{Binding .}" />
                                <!-- Entfernen -->
                                <Button Grid.Column="2" Text="✕" FontSize="14"
                                        Padding="8,4" WidthRequest="40"
                                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                                        Clicked="OnEntfernenClicked"
                                        CommandParameter="{Binding .}" />
                            </Grid>
            </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
