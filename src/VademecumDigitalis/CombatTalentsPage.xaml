<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:VademecumDigitalis.Behaviors"
             xmlns:models="clr-namespace:VademecumDigitalis.Models"
             x:Class="VademecumDigitalis.CombatTalentsPage"
             Title="Kampf">

    <ScrollView Orientation="Both">
        <VerticalStackLayout Padding="16" Spacing="12" MinimumWidthRequest="1000">

            <!-- === Hauptattribute (read-only Anzeige) === -->
            <Border Stroke="#0E7490" StrokeShape="RoundRectangle 8" Padding="12,8" BackgroundColor="#1a1a2e">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Hauptattribute" HorizontalOptions="Center" FontAttributes="Bold" FontSize="20" TextColor="#0E7490" />
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Text="MU" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />
                        <Label Grid.Row="0" Grid.Column="1" Text="KL" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />
                        <Label Grid.Row="0" Grid.Column="2" Text="IN" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />
                        <Label Grid.Row="0" Grid.Column="3" Text="CH" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />
                        <Label Grid.Row="0" Grid.Column="4" Text="FF" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />
                        <Label Grid.Row="0" Grid.Column="5" Text="GE" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />
                        <Label Grid.Row="0" Grid.Column="6" Text="KO" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />
                        <Label Grid.Row="0" Grid.Column="7" Text="KK" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />

                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding Mut}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#B0E0E6" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Klugheit}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#B0E0E6" />
                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding Intuition}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#B0E0E6" />
                        <Label Grid.Row="1" Grid.Column="3" Text="{Binding Charisma}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#B0E0E6" />
                        <Label Grid.Row="1" Grid.Column="4" Text="{Binding Fingerfertigkeit}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#B0E0E6" />
                        <Label Grid.Row="1" Grid.Column="5" Text="{Binding Gewandtheit}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#B0E0E6" />
                        <Label Grid.Row="1" Grid.Column="6" Text="{Binding Konstitution}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#B0E0E6" />
                        <Label Grid.Row="1" Grid.Column="7" Text="{Binding Körperkraft}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#B0E0E6" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- === Abgeleitete Kampfwerte === -->
            <Border Stroke="#0E7490" StrokeShape="RoundRectangle 8" Padding="12,8" BackgroundColor="#1a1a2e">
                <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0" Text="Ausweichen" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />
                    <Label Grid.Row="0" Grid.Column="1" Text="Initiative" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />
                    <Label Grid.Row="0" Grid.Column="2" Text="Seelenkraft" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />
                    <Label Grid.Row="0" Grid.Column="3" Text="Zähigkeit" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />
                    <Label Grid.Row="0" Grid.Column="4" Text="GS" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" FontSize="20" />

                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Ausweichen}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#4DD0E1" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding InitiativeBasis}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#4DD0E1" />
                    <Label Grid.Row="1" Grid.Column="2" Text="{Binding Seelenkraft}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#4DD0E1" />
                    <Label Grid.Row="1" Grid.Column="3" Text="{Binding Zähigkeit}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#4DD0E1" />
                    <Label Grid.Row="1" Grid.Column="4" Text="{Binding Geschwindigkeit}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#4DD0E1" />
                </Grid>
            </Border>

            <!-- === Lebensenergie === -->
            <Border Stroke="#B71C1C" StrokeShape="RoundRectangle 8" Padding="12,8" BackgroundColor="#1a1a2e">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Lebensenergie" FontAttributes="Bold" FontSize="20" TextColor="#EF5350"  />
                    <Grid ColumnDefinitions="Auto,Auto,60,Auto,Auto,60" ColumnSpacing="8" RowSpacing="4">
                        <Label Grid.Column="0" Text="Max:" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" FontSize="20"/>
                        <Label Grid.Column="1" Text="{Binding Lebensenergie}" FontSize="20" FontAttributes="Bold" TextColor="#EF5350" VerticalOptions="Center" />
                        <BoxView Grid.Column="2" Color="Transparent" />
                        <Label Grid.Column="3" Text="Aktuell:" FontAttributes="Bold" FontSize="20" TextColor="White" VerticalOptions="Center" />
                        <Entry Grid.Column="4" Keyboard="Numeric" Text="{Binding AktuelleLebensenergie}" FontSize="20"
                               HorizontalTextAlignment="Center" WidthRequest="80" Background="LightGray" TextColor="Black">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                    </Grid>

                    <!-- Schmerzstufen -->
                    <Label Text="{Binding SchmerzstufenDetails}" FontSize="13" TextColor="#FFAB91" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- === Kampftechniken Header === -->
            <Grid ColumnDefinitions="2*,0.8*,0.6*,0.6*,0.6*,0.5*,0.6*,0.6*"
                  ColumnSpacing="4" Padding="12,8" BackgroundColor="#0E7490">
                <Label Grid.Column="0" Text="Kampftechnik" FontAttributes="Bold" FontSize="14" TextColor="White" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="Leiteigenschaft" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="SF" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="3" Text="KTW" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="4" Text="AT/FK" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="5" Text="Boni" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="6" Text="Gesamt" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="7" Text="PA" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <!-- === Kampftechniken Zeilen === -->
            <VerticalStackLayout Spacing="0"
                                 BindableLayout.ItemsSource="{Binding Kampftechniken}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:KampftechnikRow">
                        <Grid ColumnDefinitions="2*,0.8*,0.6*,0.6*,0.6*,0.5*,0.6*,0.6*"
                              ColumnSpacing="4" Padding="12,10" BackgroundColor="#222222">
                            <Label Grid.Column="0" Text="{Binding Kampftechnik}" FontSize="14" VerticalOptions="Center" TextColor="White" />
                            <Label Grid.Column="1" Text="{Binding Leiteigenschaft}" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#B0E0E6" />
                            <Label Grid.Column="2" Text="{Binding Steigerungsfaktor}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#0E7490" />
                            <Entry Grid.Column="3" Keyboard="Numeric" Text="{Binding Ktw}" FontSize="14" HorizontalTextAlignment="Center" Background="LightGray" TextColor="Black">
                                <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                            </Entry>
                            <Label Grid.Column="4" Text="{Binding AtFkBasis}" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="#4DD0E1" />
                            <Entry Grid.Column="5" Keyboard="Numeric" Text="{Binding Boni}" FontSize="14" HorizontalTextAlignment="Center" Background="LightGray" TextColor="Black">
                                <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                            </Entry>
                            <Label Grid.Column="6" Text="{Binding Gesamt}" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="#4DD0E1" />
                            <Label Grid.Column="7" Text="{Binding Parade}" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="White" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
