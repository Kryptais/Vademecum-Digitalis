<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:VademecumDigitalis.Behaviors"
             x:Class="VademecumDigitalis.MainPage"
             Title="Charakterbogen">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Vademecum Digitalis" Style="{StaticResource HeadlineLabel}" />
            <Label Text="Digitaler DSA-5-Charakterbogen (Hauptblatt)"
                   FontSize="14" TextColor="{StaticResource TextSecondary}" Margin="0,-8,0,4" />

            <!-- Hauptattribute -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Hauptattribute" Style="{StaticResource SectionHeaderLabel}" />
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="MU" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1" Text="KL" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="2" Text="IN" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="3" Text="CH" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="4" Text="FF" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="5" Text="GE" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="6" Text="KO" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="7" Text="KK" FontAttributes="Bold" HorizontalOptions="Center" />

                        <Entry Grid.Row="1" Grid.Column="0" Keyboard="Numeric" HorizontalTextAlignment="Center" Text="{Binding Mut}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                        <Entry Grid.Row="1" Grid.Column="1" Keyboard="Numeric" HorizontalTextAlignment="Center" Text="{Binding Klugheit}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                        <Entry Grid.Row="1" Grid.Column="2" Keyboard="Numeric" HorizontalTextAlignment="Center" Text="{Binding Intuition}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                        <Entry Grid.Row="1" Grid.Column="3" Keyboard="Numeric" HorizontalTextAlignment="Center" Text="{Binding Charisma}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                        <Entry Grid.Row="1" Grid.Column="4" Keyboard="Numeric" HorizontalTextAlignment="Center" Text="{Binding Fingerfertigkeit}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                        <Entry Grid.Row="1" Grid.Column="5" Keyboard="Numeric" HorizontalTextAlignment="Center" Text="{Binding Gewandtheit}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                        <Entry Grid.Row="1" Grid.Column="6" Keyboard="Numeric" HorizontalTextAlignment="Center" Text="{Binding Konstitution}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                        <Entry Grid.Row="1" Grid.Column="7" Keyboard="Numeric" HorizontalTextAlignment="Center" Text="{Binding Körperkraft}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Charakterinfos -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Charakterinfos" Style="{StaticResource SectionHeaderLabel}" />

                    <Label Text="Name" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Name" Text="{Binding Name}" />

                    <Label Text="Spieler" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Spieler" Text="{Binding Spieler}" />

                    <Label Text="Spezies" Style="{StaticResource FieldLabel}" />
                    <Picker Title="Spezies wählen..."
                            ItemsSource="{Binding SpeziesListe}"
                            SelectedItem="{Binding Spezies, Mode=TwoWay}"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="{StaticResource InputBackground}" />
                    <Label Text="{Binding SpeziesInfoText}"
                           FontSize="12" TextColor="{StaticResource TextSecondary}"
                           Margin="4,0,0,0" />

                    <Label Text="Kultur" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Kultur" Text="{Binding Kultur}" />

                    <Label Text="Profession" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Profession" Text="{Binding Profession}" />

                    <Label Text="Geschlecht" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Geschlecht" Text="{Binding Geschlecht}" />

                    <Label Text="Geburtstag" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Placeholder="z. B. 12. Rahja 1038 BF" Text="{Binding Geburtstag}" />
                        <Button Grid.Column="1" Text="📅" FontSize="16" Padding="10,6"
                                WidthRequest="50"
                                Clicked="OnGeburtstagPickerClicked"
                                BackgroundColor="{StaticResource AccentCyan}" />
                    </Grid>

                    <Label Text="Alter" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding AlterBerechnet}"
                           FontSize="15" FontAttributes="Bold" TextColor="{StaticResource AccentCyan}" />

                    <Label Text="Größe" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Größe" Text="{Binding Größe}" />

                    <Label Text="Gewicht" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Gewicht" Text="{Binding Gewicht}" />

                    <Label Text="Haarfarbe" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Haarfarbe" Text="{Binding Haarfarbe}" />

                    <Label Text="Augenfarbe" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Augenfarbe" Text="{Binding Augenfarbe}" />

                    <Label Text="Sozialstatus" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Sozialstatus" Text="{Binding Sozialstatus}" />
                </VerticalStackLayout>
            </Border>

            <!-- Basiswerte (berechnet + Zugekauft + Boni) -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Basiswerte" Style="{StaticResource SectionHeaderLabel}" />
                    <Label Text="Basis = Formelwert | Zukauf = über AP | Boni = Vorteile/SF | Gesamt = Summe"
                           FontSize="11" TextColor="{StaticResource TextSecondary}" Margin="0,-4,0,4" />

                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Padding="0,0,0,4">
                        <Label Grid.Column="0" Text="" />
                        <Label Grid.Column="1" Text="Basis" FontAttributes="Bold" FontSize="12" WidthRequest="52" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="2" Text="Zukauf" FontAttributes="Bold" FontSize="12" WidthRequest="55" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="3" Text="Boni" FontAttributes="Bold" FontSize="12" WidthRequest="55" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="4" Text="Gesamt" FontAttributes="Bold" FontSize="13" WidthRequest="55" HorizontalTextAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <!-- LeP -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Lebensenergie (LeP)" />
                            <Label Text="{Binding LebensenergieFormel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding LebensenergieBasis}" WidthRequest="52"
                               FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Entry Grid.Row="0" Grid.Column="2" WidthRequest="55" Keyboard="Numeric" Text="{Binding LebensenergieZugekauft}" HorizontalTextAlignment="Center">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                        <Label Grid.Row="0" Grid.Column="3" Text="{Binding LebensenergieBoniGesamt, StringFormat='{0:+#;-#;0}'}" WidthRequest="55" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="4" Text="{Binding Lebensenergie}" WidthRequest="55"
                               FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center" />

                        <!-- AsP -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Astralenergie (AsP)" />
                            <Label Text="{Binding AstralenergieFormel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Row="1" Grid.Column="1" Text="&#x2014;" WidthRequest="52"
                               HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Entry Grid.Row="1" Grid.Column="2" WidthRequest="55" Keyboard="Numeric" Text="{Binding AstralenergieZugekauft}" HorizontalTextAlignment="Center">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                        <Label Grid.Row="1" Grid.Column="3" Text="{Binding AstralergieBoniGesamt, StringFormat='{0:+#;-#;0}'}" WidthRequest="55" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.Column="4" Text="{Binding Astralenergie}" WidthRequest="55"
                               FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center" />

                        <!-- KaP -->
                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Karmaenergie (KaP)" />
                            <Label Text="{Binding KarmaenergieFormel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Row="2" Grid.Column="1" Text="&#x2014;" WidthRequest="52"
                               HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Entry Grid.Row="2" Grid.Column="2" WidthRequest="55" Keyboard="Numeric" Text="{Binding KarmaenergieZugekauft}" HorizontalTextAlignment="Center">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                        <Label Grid.Row="2" Grid.Column="3" Text="{Binding KarmaenergieBoniGesamt, StringFormat='{0:+#;-#;0}'}" WidthRequest="55" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <Label Grid.Row="2" Grid.Column="4" Text="{Binding Karmaenergie}" WidthRequest="55"
                               FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center" />

                        <!-- SK -->
                        <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Seelenkraft (SK)" />
                            <Label Text="{Binding SeelenkraftFormel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding SeelenkraftBasis}" WidthRequest="52"
                               FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="3" Grid.Column="2" Text="&#x2014;" WidthRequest="55"
                               HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="3" Grid.Column="3" Text="{Binding SeelenkraftBoniGesamt, StringFormat='{0:+#;-#;0}'}" WidthRequest="55" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <Label Grid.Row="3" Grid.Column="4" Text="{Binding Seelenkraft}" WidthRequest="55"
                               FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center" />

                        <!-- ZK -->
                        <VerticalStackLayout Grid.Row="4" Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Z&#xE4;higkeit (ZK)" />
                            <Label Text="{Binding Z&#xE4;higkeitFormel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding Z&#xE4;higkeitBasis}" WidthRequest="52"
                               FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="4" Grid.Column="2" Text="&#x2014;" WidthRequest="55"
                               HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="4" Grid.Column="3" Text="{Binding Z&#xE4;higkeitBoniGesamt, StringFormat='{0:+#;-#;0}'}" WidthRequest="55" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <Label Grid.Row="4" Grid.Column="4" Text="{Binding Z&#xE4;higkeit}" WidthRequest="55"
                               FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center" />

                        <!-- INI (kein Zukauf) -->
                        <VerticalStackLayout Grid.Row="5" Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Initiative-Basis (INI)" />
                            <Label Text="{Binding InitiativeBasisFormel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding InitiativeBasisBerechnet}" WidthRequest="52"
                               FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="5" Grid.Column="2" Text="&#x2014;" WidthRequest="55"
                               HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="5" Grid.Column="3" Text="{Binding InitiativeBasisBoniGesamt, StringFormat='{0:+#;-#;0}'}" WidthRequest="55" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <Label Grid.Row="5" Grid.Column="4" Text="{Binding InitiativeBasis}" WidthRequest="55"
                               FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center" />

                        <!-- GS (Spezies-abh&#xE4;ngig, kein Zukauf) -->
                        <VerticalStackLayout Grid.Row="6" Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Geschwindigkeit (GS)" />
                            <Label Text="{Binding GeschwindigkeitFormel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Row="6" Grid.Column="1" Text="{Binding GeschwindigkeitBasis}" WidthRequest="52"
                               FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="6" Grid.Column="2" Text="&#x2014;" WidthRequest="55"
                               HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="6" Grid.Column="3" Text="{Binding GeschwindigkeitBoniGesamt, StringFormat='{0:+#;-#;0}'}" WidthRequest="55" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <Label Grid.Row="6" Grid.Column="4" Text="{Binding Geschwindigkeit}" WidthRequest="55"
                               FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center" />

                        <!-- WS (Wundschwelle, read-only) -->
                        <VerticalStackLayout Grid.Row="7" Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Wundschwelle (WS)" />
                            <Label Text="{Binding WundschwelleFormel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Row="7" Grid.Column="1" Text="{Binding Wundschwelle}" WidthRequest="52"
                               FontSize="14" HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="7" Grid.Column="2" Text="&#x2014;" WidthRequest="55"
                               HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="7" Grid.Column="3" Text="&#x2014;" WidthRequest="55"
                               HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Row="7" Grid.Column="4" Text="{Binding Wundschwelle}" WidthRequest="55"
                               FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Abenteuerpunkte -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Abenteuerpunkte" Style="{StaticResource SectionHeaderLabel}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <Label Grid.Row="0" Text="AP gesamt" VerticalOptions="Center" />
                        <Entry Grid.Row="0" Grid.Column="1" WidthRequest="90" Keyboard="Numeric" Text="{Binding AbenteuerpunkteGesamt}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>

                        <Label Grid.Row="1" Text="AP verfügbar" VerticalOptions="Center" />
                        <Entry Grid.Row="1" Grid.Column="1" WidthRequest="90" Keyboard="Numeric" Text="{Binding AbenteuerpunkteVerfuegbar}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>

                        <Label Grid.Row="2" Text="AP ausgegeben" VerticalOptions="Center" />
                        <Entry Grid.Row="2" Grid.Column="1" WidthRequest="90" Keyboard="Numeric" Text="{Binding AbenteuerpunkteAusgegeben}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Schicksalspunkte -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Schicksalspunkte" Style="{StaticResource SectionHeaderLabel}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <Label Grid.Row="0" Text="SchiP gesamt" VerticalOptions="Center" />
                        <Entry Grid.Row="0" Grid.Column="1" WidthRequest="90" Keyboard="Numeric" Text="{Binding SchicksalspunkteGesamt}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>

                        <Label Grid.Row="1" Text="SchiP verfügbar" VerticalOptions="Center" />
                        <Entry Grid.Row="1" Grid.Column="1" WidthRequest="90" Keyboard="Numeric" Text="{Binding SchicksalspunkteVerfuegbar}">
                            <Entry.Behaviors><behaviors:NumericEntryBehavior /></Entry.Behaviors>
                        </Entry>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
