<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:VademecumDigitalis.Converters"
             xmlns:vm="clr-namespace:VademecumDigitalis.ViewModels"
             xmlns:models="clr-namespace:VademecumDigitalis.Models"
             x:Class="VademecumDigitalis.BoronKalenderPage"
             x:Name="KalenderSeite"
             Title="Kalender">

    <ContentPage.Resources>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Aktuelles Spielwelt-Datum -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Aktuelles Spielwelt-Datum" Style="{StaticResource SectionHeaderLabel}" />

                    <Label Text="{Binding AktuellesDatumText}"
                           FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource AccentCyan}"
                           HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="- Tag"
                                Command="{Binding TagZur&#xFC;ckCommand}"
                                FontSize="13" Padding="8,6" />
                        <Button Grid.Column="1" Text="Tag +"
                                Command="{Binding TagVorCommand}"
                                FontSize="13" Padding="8,6" />
                        <Button Grid.Column="2" Text="+7 Tage"
                                Command="{Binding WocheVorCommand}"
                                FontSize="13" Padding="8,6" />
                        <Button Grid.Column="3" Text="Heute"
                                Command="{Binding SpringeZuHeuteCommand}"
                                FontSize="13" Padding="8,6"
                                BackgroundColor="{StaticResource AccentCyan}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Monatsnavigation -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="&lt;" Command="{Binding VorherigerMonatCommand}"
                                WidthRequest="50" FontSize="18" Padding="4" />
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding AngezeigterMonatName}"
                                   FontSize="20" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding AngezeigtesJahr, StringFormat='{0} BF'}"
                                   FontSize="14" TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="&gt;" Command="{Binding N&#xE4;chsterMonatCommand}"
                                WidthRequest="50" FontSize="18" Padding="4" />
                    </Grid>

                    <!-- Wochentag-Kopfzeile (Pr = Praiostag = Ruhetag, grün hervorgehoben) -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4" Margin="0,6,0,2">
                        <Label Grid.Column="0" Text="Wi" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="1" Text="Er" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="2" Text="Ma" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="3" Text="Pr" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#4ADE80" />
                        <Label Grid.Column="4" Text="Ro" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="5" Text="Fe" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="6" Text="Wa" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                    </Grid>

                    <!-- Tagesraster (7 Spalten = Wochentage, kein Scroll) -->
                    <VerticalStackLayout Spacing="4"
                                         BindableLayout.ItemsSource="{Binding AngezeigteZeilen}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:KalenderZeile">
                                <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4">

                                    <Border Grid.Column="0" HeightRequest="56" StrokeShape="RoundRectangle 8" StrokeThickness="2"
                                            BackgroundColor="{Binding Tag0.TileBackground}" Stroke="{Binding Tag0.TileBorder}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.TagAusw&#xE4;hlenCommand, Source={x:Reference KalenderSeite}}" CommandParameter="{Binding Tag0}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,10" IsVisible="{Binding Tag0.ShowContent}">
                                            <Label Grid.Row="0" Text="{Binding Tag0.Tag}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Ellipse Grid.Row="1" WidthRequest="6" HeightRequest="6" Fill="#FCD34D" IsVisible="{Binding Tag0.HatEintrag}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1" HeightRequest="56" StrokeShape="RoundRectangle 8" StrokeThickness="2"
                                            BackgroundColor="{Binding Tag1.TileBackground}" Stroke="{Binding Tag1.TileBorder}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.TagAusw&#xE4;hlenCommand, Source={x:Reference KalenderSeite}}" CommandParameter="{Binding Tag1}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,10" IsVisible="{Binding Tag1.ShowContent}">
                                            <Label Grid.Row="0" Text="{Binding Tag1.Tag}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Ellipse Grid.Row="1" WidthRequest="6" HeightRequest="6" Fill="#FCD34D" IsVisible="{Binding Tag1.HatEintrag}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" HeightRequest="56" StrokeShape="RoundRectangle 8" StrokeThickness="2"
                                            BackgroundColor="{Binding Tag2.TileBackground}" Stroke="{Binding Tag2.TileBorder}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.TagAusw&#xE4;hlenCommand, Source={x:Reference KalenderSeite}}" CommandParameter="{Binding Tag2}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,10" IsVisible="{Binding Tag2.ShowContent}">
                                            <Label Grid.Row="0" Text="{Binding Tag2.Tag}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Ellipse Grid.Row="1" WidthRequest="6" HeightRequest="6" Fill="#FCD34D" IsVisible="{Binding Tag2.HatEintrag}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="3" HeightRequest="56" StrokeShape="RoundRectangle 8" StrokeThickness="2"
                                            BackgroundColor="{Binding Tag3.TileBackground}" Stroke="{Binding Tag3.TileBorder}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.TagAusw&#xE4;hlenCommand, Source={x:Reference KalenderSeite}}" CommandParameter="{Binding Tag3}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,10" IsVisible="{Binding Tag3.ShowContent}">
                                            <Label Grid.Row="0" Text="{Binding Tag3.Tag}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Ellipse Grid.Row="1" WidthRequest="6" HeightRequest="6" Fill="#FCD34D" IsVisible="{Binding Tag3.HatEintrag}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="4" HeightRequest="56" StrokeShape="RoundRectangle 8" StrokeThickness="2"
                                            BackgroundColor="{Binding Tag4.TileBackground}" Stroke="{Binding Tag4.TileBorder}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.TagAusw&#xE4;hlenCommand, Source={x:Reference KalenderSeite}}" CommandParameter="{Binding Tag4}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,10" IsVisible="{Binding Tag4.ShowContent}">
                                            <Label Grid.Row="0" Text="{Binding Tag4.Tag}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Ellipse Grid.Row="1" WidthRequest="6" HeightRequest="6" Fill="#FCD34D" IsVisible="{Binding Tag4.HatEintrag}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="5" HeightRequest="56" StrokeShape="RoundRectangle 8" StrokeThickness="2"
                                            BackgroundColor="{Binding Tag5.TileBackground}" Stroke="{Binding Tag5.TileBorder}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.TagAusw&#xE4;hlenCommand, Source={x:Reference KalenderSeite}}" CommandParameter="{Binding Tag5}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,10" IsVisible="{Binding Tag5.ShowContent}">
                                            <Label Grid.Row="0" Text="{Binding Tag5.Tag}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Ellipse Grid.Row="1" WidthRequest="6" HeightRequest="6" Fill="#FCD34D" IsVisible="{Binding Tag5.HatEintrag}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="6" HeightRequest="56" StrokeShape="RoundRectangle 8" StrokeThickness="2"
                                            BackgroundColor="{Binding Tag6.TileBackground}" Stroke="{Binding Tag6.TileBorder}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.TagAusw&#xE4;hlenCommand, Source={x:Reference KalenderSeite}}" CommandParameter="{Binding Tag6}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,10" IsVisible="{Binding Tag6.ShowContent}">
                                            <Label Grid.Row="0" Text="{Binding Tag6.Tag}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Ellipse Grid.Row="1" WidthRequest="6" HeightRequest="6" Fill="#FCD34D" IsVisible="{Binding Tag6.HatEintrag}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Tagesdetails & Kalender-Einträge -->
            <Border Stroke="#D1D5DB" StrokeShape="RoundRectangle 12" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tagesdetails &amp; Einträge" Style="{StaticResource SectionHeaderLabel}" />
                    <Label Text="{Binding SelectedTagText}"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource AccentCyan}" />

                    <!-- Eintrags-Liste für den gewählten Tag -->
                    <CollectionView ItemsSource="{Binding SelectedTagEintraege}"
                                    SelectionMode="None"
                                    EmptyView="Keine Einträge – Tag antippen, dann unten hinzufügen.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:KalenderEintrag">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,3">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Text="{Binding Titel}" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="{Binding BeschreibungKurz}" FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="🗑"
                                            BackgroundColor="Transparent" TextColor="#DC2626"
                                            FontSize="18" Padding="4"
                                            Clicked="OnEintragLoeschen"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Neuen Eintrag hinzufügen -->
                    <Label Text="Neuer Eintrag für gewählten Tag" FontSize="12" FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}" Margin="0,8,0,0" />
                    <Entry x:Name="NeuEintragTitelEntry"
                           Placeholder="Titel (z. B. Geburtstag Rohaja, Praiostag-Fest ...)"
                           FontSize="13" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Jährlich wiederkehrend" FontSize="13" VerticalOptions="Center" />
                        <Switch x:Name="NeuEintragJaehrlichSwitch" Grid.Column="1" IsToggled="True" />
                    </Grid>
                    <Button Text="✚ Eintrag hinzufügen"
                            Clicked="OnEintragHinzufuegen"
                            BackgroundColor="#0E7490" TextColor="White" Padding="12,10" />
                </VerticalStackLayout>
            </Border>

            <!-- Aventurischer Kalender Referenz -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Aventurische Monate" Style="{StaticResource SectionHeaderLabel}" />
                    <Label Text="12 Monate a 30 Tage + 5 Namenlose Tage = 365 Tage/Jahr"
                           FontSize="12" TextColor="{StaticResource TextSecondary}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" RowSpacing="4" ColumnSpacing="12" Padding="4,8,4,0">
                        <Label Grid.Column="0" Text="#" FontAttributes="Bold" FontSize="13" />
                        <Label Grid.Column="1" Text="Monat" FontAttributes="Bold" FontSize="13" />
                        <Label Grid.Column="2" Text="Tage" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" />
                    </Grid>

                    <CollectionView ItemsSource="{x:Static models:BoronKalender.Monate}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="4,3">
                                    <Label Grid.Column="0" Text="{Binding Index}" FontSize="13"
                                           TextColor="{StaticResource TextSecondary}" WidthRequest="24" />
                                    <Label Grid.Column="1" Text="{Binding Name}" FontSize="13" FontAttributes="Bold" />
                                    <Label Grid.Column="2" Text="{Binding Tage}" FontSize="13"
                                           HorizontalTextAlignment="End" WidthRequest="30" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

                </VerticalStackLayout>
            </ScrollView>

</ContentPage>
