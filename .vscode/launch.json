{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run MAUI Windows",
            "type": "coreclr",
            "request": "launch",
            "program": "C:\\Program Files\\dotnet\\dotnet.exe",
            "args": [
                "build",
                "${workspaceFolder}\\src\\VademecumDigitalis\\VademecumDigitalis.csproj",
                "-t:Run",
                "-f",
                "net9.0-windows10.0.19041.0"
            ],
            "cwd": "${workspaceFolder}\\src\\VademecumDigitalis",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Run MAUI Android",
            "type": "coreclr",
            "request": "launch",
            "program": "C:\\Program Files\\dotnet\\dotnet.exe",
            "args": [
                "build",
                "${workspaceFolder}\\src\\VademecumDigitalis\\VademecumDigitalis.csproj",
                "-t:Run",
                "-f",
                "net9.0-android"
            ],
            "cwd": "${workspaceFolder}\\src\\VademecumDigitalis",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
